[
  {
    "id": "root",
    "component": "Column",
    "children": [
      "sub_card",
      "cancel_modal"
    ],
    "justify": "start",
    "align": "stretch"
  },
  {
    "id": "sub_card",
    "component": "Card",
    "child": "card_content"
  },
  {
    "id": "card_content",
    "component": "Column",
    "children": [
      "card_header_row",
      "price_row",
      "divider_1",
      "details_col",
      "divider_2",
      "actions_row"
    ]
  },
  {
    "id": "card_header_row",
    "component": "Row",
    "children": [
      "plan_header_left",
      "status_badge"
    ],
    "justify": "spaceBetween",
    "align": "center"
  },
  {
    "id": "plan_header_left",
    "component": "Row",
    "children": [
      "plan_icon",
      "plan_title_col"
    ],
    "align": "center"
  },
  {
    "id": "plan_icon",
    "component": "Icon",
    "name": "star"
  },
  {
    "id": "plan_title_col",
    "component": "Column",
    "children": [
      "plan_title",
      "plan_subtitle"
    ]
  },
  {
    "id": "plan_title",
    "component": "Text",
    "text": "Pro Plan Subscription",
    "variant": "heading"
  },
  {
    "id": "plan_subtitle",
    "component": "Text",
    "text": "Billed annually",
    "variant": "caption"
  },
  {
    "id": "status_badge",
    "component": "Text",
    "text": "Active",
    "variant": "caption"
  },
  {
    "id": "price_row",
    "component": "Row",
    "children": [
      "price_text",
      "price_period"
    ],
    "align": "baseline"
  },
  {
    "id": "price_text",
    "component": "Text",
    "text": "$29.00",
    "variant": "heading"
  },
  {
    "id": "price_period",
    "component": "Text",
    "text": " / month",
    "variant": "caption"
  },
  {
    "id": "divider_1",
    "component": "Divider",
    "axis": "horizontal"
  },
  {
    "id": "details_col",
    "component": "Column",
    "children": [
      "billing_row",
      "payment_row"
    ]
  },
  {
    "id": "billing_row",
    "component": "Row",
    "children": [
      "billing_label",
      "billing_value"
    ],
    "justify": "spaceBetween"
  },
  {
    "id": "billing_label",
    "component": "Text",
    "text": "Next Billing Date",
    "variant": "caption"
  },
  {
    "id": "billing_value",
    "component": "Text",
    "text": "March 15, 2026",
    "variant": "body"
  },
  {
    "id": "payment_row",
    "component": "Row",
    "children": [
      "payment_label",
      "payment_value"
    ],
    "justify": "spaceBetween"
  },
  {
    "id": "payment_label",
    "component": "Text",
    "text": "Payment Method",
    "variant": "caption"
  },
  {
    "id": "payment_value",
    "component": "Text",
    "text": "Visa ending in 4242",
    "variant": "body"
  },
  {
    "id": "divider_2",
    "component": "Divider",
    "axis": "horizontal"
  },
  {
    "id": "actions_row",
    "component": "Row",
    "children": [
      "upgrade_button",
      "cancel_button"
    ],
    "justify": "end"
  },
  {
    "id": "upgrade_button",
    "component": "Button",
    "child": "upgrade_btn_text",
    "variant": "secondary"
  },
  {
    "id": "upgrade_btn_text",
    "component": "Text",
    "text": "Change Plan"
  },
  {
    "id": "cancel_button",
    "component": "Button",
    "child": "cancel_btn_text",
    "variant": "tertiary"
  },
  {
    "id": "cancel_btn_text",
    "component": "Text",
    "text": "Cancel Subscription"
  },
  {
    "id": "cancel_modal",
    "component": "Modal",
    "trigger": "cancel_button",
    "child": "modal_content"
  },
  {
    "id": "modal_content",
    "component": "Column",
    "children": [
      "modal_header",
      "modal_body_text",
      "reason_label",
      "reason_picker",
      "divider_3",
      "modal_footer"
    ]
  },
  {
    "id": "modal_header",
    "component": "Row",
    "children": [
      "warning_icon",
      "modal_title"
    ],
    "align": "center"
  },
  {
    "id": "warning_icon",
    "component": "Icon",
    "name": "warning"
  },
  {
    "id": "modal_title",
    "component": "Text",
    "text": "Cancel Subscription?",
    "variant": "heading"
  },
  {
    "id": "modal_body_text",
    "component": "Text",
    "text": "Are you sure you want to cancel your Pro Plan subscription? You will continue to have access to premium features until your current cycle ends on March 15, 2026.",
    "variant": "body"
  },
  {
    "id": "reason_label",
    "component": "Text",
    "text": "Please tell us why you're leaving:",
    "variant": "caption"
  },
  {
    "id": "reason_picker",
    "component": "ChoicePicker",
    "variant": "mutuallyExclusive",
    "options": [
      {
        "label": "Too expensive",
        "value": "expensive"
      },
      {
        "label": "Not using it enough",
        "value": "infrequent"
      },
      {
        "label": "Missing key features",
        "value": "features"
      },
      {
        "label": "Switching to another service",
        "value": "competitor"
      }
    ],
    "value": {
      "path": "/cancellation/reason"
    }
  },
  {
    "id": "divider_3",
    "component": "Divider",
    "axis": "horizontal"
  },
  {
    "id": "modal_footer",
    "component": "Row",
    "children": [
      "keep_button",
      "confirm_cancel_button"
    ],
    "justify": "end"
  },
  {
    "id": "keep_button",
    "component": "Button",
    "child": "keep_btn_text",
    "variant": "secondary"
  },
  {
    "id": "keep_btn_text",
    "component": "Text",
    "text": "Keep My Plan"
  },
  {
    "id": "confirm_cancel_button",
    "component": "Button",
    "child": "confirm_btn_text",
    "variant": "primary",
    "action": {
      "event": {
        "name": "confirmCancellation",
        "context": {
          "reason": {
            "path": "/cancellation/reason"
          }
        }
      }
    }
  },
  {
    "id": "confirm_btn_text",
    "component": "Text",
    "text": "Confirm Cancellation"
  }
]